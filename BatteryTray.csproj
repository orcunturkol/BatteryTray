<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: Windows APIs for Bluetooth LE (AirPods) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BatteryTray</AssemblyName>
    <RootNamespace>BatteryTray</RootNamespace>
    <Version>0.0.7</Version>
    <!-- Compress the self-contained single-file exe (~180 MB -> roughly 70-80 MB).
         Only takes effect for a self-contained, single-file publish (see README). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

</Project>
